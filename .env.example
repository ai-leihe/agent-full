# ============================================================
# 公共环境变量模板 —— 复制成 .env 后按本机实际情况填写
#     Windows:  copy .env.example .env
#     Linux/mac: cp .env.example .env
# ------------------------------------------------------------
# .env 是真实值，不入库；本文件只放占位符，用于说明有哪些配置项。
# 新增配置项时，请同时更新本文件与 app/core/env.py 的文档。
#
# 语法：KEY=VALUE，支持 ${VAR} 引用本文件内或系统里已定义的变量，
#       引用顺序无关。值里若含 # 请用引号包起来（"..."）。
# 优先级：系统环境变量 > .env（.env 不会覆盖已存在的系统变量）。
# ============================================================

# ---------------- 平台自身数据库（设置 / 账号 / 会话 / 运行记录 / 知识库 / 方案）----------------
# 留空时退化为 SQLite 文件 <data>/platform.db（开箱即用，适合本地/单机）。
# 换成 mysql:// 或 postgresql:// 即可切库（驱动已随 requirements.txt 提供）：
#   PLATFORM_DATABASE_URL=mysql://app:change-me@127.0.0.1:3306/agent_platform?charset=utf8mb4
#   PLATFORM_DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/agent_platform
PLATFORM_DATABASE_URL=

# ---------------- MySQL 连接（应用侧使用业务账号）----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=demo
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_CHARSET=utf8mb4

# 派生值：sql_loader 直接引用它，改上面几项即可自动生效
MYSQL_DSN=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?charset=${MYSQL_CHARSET}

# ---------------- 管理员账号（仅 D:\mysql\*.bat 使用）----------------
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=change-me

# ---------------- 便携 MySQL 实例（仅 D:\mysql\*.bat 使用）----------------
MYSQL_BASE=D:\mysql
MYSQL_HOME=D:\mysql\mysql-8.0.28-winx64
MYSQL_SERVICE=MySQL80

# ---------------- Milvus 向量库（milvus_store 插件的连接配置）----------------
# config/pipeline.yaml 与 config/orchestrations/*.yaml 里的 ${MILVUS_*}
# 都指向这里；本地部署见 deploy/milvus/docker-compose.yml
MILVUS_URI=http://localhost:19530

# 多次上传共用一个集合（靠 run_id 隔离）；换集合等于换一个独立的向量库
MILVUS_COLLECTION=default

# COSINE / IP（分数越高越相似，与 memory_store 口径一致）
MILVUS_METRIC_TYPE=COSINE

# 形如 user:password；本地 Standalone 无鉴权，留空即可
MILVUS_TOKEN=
